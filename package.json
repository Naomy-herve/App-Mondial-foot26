{
  "name": "foot26",
  "version": "2.0.0",
  "private": true,
  "description": "FOOT26 - plateforme de gestion de championnat de football, API Express + Supabase + Android Capacitor",
  "main": "server/server.js",
  "scripts": {
    "dev": "node --watch server/server.js",
    "start": "node server/server.js",
    "check": "node --check server/server.js && node --check public/js/api.js && node --check public/js/app.js && node --check scripts/build-web.js && node --check scripts/build-mobile.js",
    "build:web": "node scripts/build-web.js",
    "build:mobile": "node scripts/build-mobile.js",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android",
    "cap:build:apk": "npx cap build android --androidreleasetype APK"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@vercel/node": "^5.5.0"
  }
}
